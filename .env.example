# Copy to .env and adjust. Values here are startup defaults; operator changes
# made in the dashboard are saved in the database and take precedence
# (Operator → Analysis → "Restore defaults from .env" to re-apply these).

# Browser URL: http://localhost:8080
APP_PORT=8080
# 127.0.0.1 = only this laptop can open the app. 0.0.0.0 = any device on the
# network (e.g. a second display); keep OPERATOR_PIN set if you do this.
APP_BIND=127.0.0.1

# simulation | evb_lite | csv_replay
SENSOR_MODE=simulation
# EVB Lite IP address on the UniFi network (see README → Sensor network).
EVB_HOST=
EVB_PORT=80
EVB_TIMEOUT_SECONDS=5
EVB_ACCEL_RANGE_G=16
# Verified EVB Lite protocol profile (see docs/evb-lite-integration.md).
EVB_PROFILE_PATH=/app/config/evb_profile.json

# Test data is stored in the Docker volume "mission-data" (not in this folder).
# Back it up with:  docker compose cp app:/data/mars_lander.db .\backup.db

# PIN for the operator dashboard (Ctrl+Shift+O). Change it before the event.
OPERATOR_PIN=1113

# Simulation
SIM_SAMPLE_RATE_HZ=1600
# Optional fixed seed for reproducible simulated drops (blank = random).
SIM_SEED=

LOG_LEVEL=INFO
